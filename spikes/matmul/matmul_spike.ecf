<?xml version="1.0" encoding="ISO-8859-1"?>
<system xmlns="http://www.eiffel.com/developers/xml/configuration/22" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.eiffel.com/developers/xml/configuration/22 http://www.eiffel.com/developers/xml/configuration/22/configuration.xsd" name="matmul_spike" uuid="4B8E2F61-9D3A-4C7B-A1E5-6F0D2C8B3E94">
	<target name="matmul_spike">
		<root class="MATMUL_SPIKE" feature="make"/>
		<option warning="error" void_safety="all">
			<assertions precondition="false" postcondition="false" invariant="false"/>
		</option>
		<setting name="total_order_on_reals" value="true"/>
		<setting name="inlining" value="true"/>
		<setting name="inlining_size" value="10"/>
		<capability>
			<concurrency support="none"/>
			<void_safety support="all"/>
		</capability>
		<library name="base" location="$ISE_LIBRARY/library/base/base.ecf"/>
		<cluster name="spike" location="./"/>
	</target>
</system>
